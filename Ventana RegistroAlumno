import javax.swing.*;
import javax.swing.border.*;
import java.awt.*;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.ArrayList;
import java.util.List;

public class RegistroAlumno extends JFrame {

    private final JTextField[] campos = new JTextField[4];
    private final JComboBox<String> cmbCinta = new JComboBox<>(new String[] {
    		"Seleccionar...", "Blanca", "Amarilla", "Naranja", "Verde", "Azul", "Marrón", "Roja", "Roja negra", "Negra"});
    private final List<String[]> alumnos = new ArrayList<>();

    private static final Font FUENTE = new Font("Arial", Font.BOLD, 13);

    public RegistroAlumno() {
        setTitle("Registro alumno");
        setSize(820, 480);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setResizable(false);

        JPanel raiz = new JPanel(new BorderLayout());
        raiz.setBackground(Color.WHITE);
        raiz.setBorder(new LineBorder(Color.DARK_GRAY, 2, true));
        setContentPane(raiz);

        raiz.add(crearEncabezado(), BorderLayout.NORTH);
        raiz.add(crearFormulario(), BorderLayout.CENTER);
        raiz.add(crearBotones(), BorderLayout.SOUTH);
    }

    private JPanel crearEncabezado() {
        JPanel p = new JPanel(new BorderLayout());
        p.setBackground(Color.WHITE);
        p.setBorder(new MatteBorder(0, 0, 2, 0, Color.DARK_GRAY));
        p.setPreferredSize(new Dimension(0, 80));

       
        JLabel logo = new JLabel();
        logo.setPreferredSize(new Dimension(80, 80));
        java.net.URL url = getClass().getResource("/logo.png");
        if (url != null) {
            Image img = new ImageIcon(url).getImage().getScaledInstance(70, 70, Image.SCALE_SMOOTH);
            logo.setIcon(new ImageIcon(img));
        } else {
            logo.setText("LOGO");
        }

        JLabel titulo = new JLabel("Registro alumno");
        titulo.setFont(FUENTE);

        JPanel izquierda = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 0));
        izquierda.setOpaque(false);
        izquierda.add(logo);
        izquierda.add(titulo);

        JLabel rol = new JLabel("Secretaria");
        rol.setFont(new Font("Arial", Font.BOLD, 16));

        JPanel derecha = new JPanel(new FlowLayout(FlowLayout.RIGHT, 12, 12));
        derecha.setOpaque(false);
        derecha.add(rol);
        derecha.add(new Avatar());

        p.add(izquierda, BorderLayout.WEST);
        p.add(derecha, BorderLayout.EAST);
        return p;
    }

   
    private JPanel crearFormulario() {
        JPanel p = new JPanel(new GridBagLayout());
        p.setBackground(Color.WHITE);
        p.setBorder(new EmptyBorder(20, 40, 10, 40));

        String[] etiquetas = {"Nombre:", "Teléfono:", "Edad:", "Correo:", "Nivel de cinta:"};
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(10, 0, 10, 0);

        for (int i = 0; i < etiquetas.length; i++) {
            JLabel lbl = new JLabel(etiquetas[i]);
            lbl.setFont(FUENTE);
            gbc.gridx = 0;
            gbc.gridy = i;
            gbc.weightx = 0;
            gbc.fill = GridBagConstraints.NONE;
            gbc.anchor = GridBagConstraints.WEST;
            gbc.ipadx = 50;
            p.add(lbl, gbc);

            JComponent campo;
            if (i == 4) {
                cmbCinta.setFont(new Font("Arial", Font.PLAIN, 13));
                cmbCinta.setBackground(Color.WHITE);
                campo = cmbCinta;
            } else {
                JTextField txt = new JTextField();
                txt.setBorder(new CompoundBorder(
                        new LineBorder(Color.DARK_GRAY, 1, true),
                        new EmptyBorder(0, 8, 0, 8)));
                campos[i] = txt;
                campo = txt;
            }
            campo.setPreferredSize(new Dimension(0, 32));
            gbc.gridx = 1;
            gbc.weightx = 1;
            gbc.fill = GridBagConstraints.HORIZONTAL;
            gbc.ipadx = 0;
            p.add(campo, gbc);
        }
        return p;
    }

   
    private JPanel crearBotones() {
        JPanel p = new JPanel(new FlowLayout(FlowLayout.RIGHT, 15, 10));
        p.setBackground(Color.WHITE);
        p.setBorder(new EmptyBorder(0, 0, 15, 25));
        JButton btnRegistrar = crearBoton("Registrar");
        JButton btnCancelar = crearBoton("Cancelar");
        btnRegistrar.addActionListener(e -> registrar());
        btnCancelar.addActionListener(e -> limpiar());
        p.add(btnRegistrar);
        p.add(btnCancelar);
        return p;
    }

    private JButton crearBoton(String texto) {
        JButton b = new JButton(texto);
        b.setFont(new Font("Arial", Font.BOLD, 12));
        b.setBackground(Color.WHITE);
        b.setFocusPainted(false);
        b.setPreferredSize(new Dimension(130, 36));
        b.setBorder(new LineBorder(Color.BLACK, 2, true));
        return b;
    }

    private void registrar() {
        String nombre = campos[0].getText().trim();
        String telefono = campos[1].getText().trim();
        String edadTxt = campos[2].getText().trim();
        String correo = campos[3].getText().trim();
        String nivel = cmbCinta.getSelectedIndex() == 0 ? "" : (String) cmbCinta.getSelectedItem();

        if (nombre.isEmpty() || telefono.isEmpty() || edadTxt.isEmpty() || correo.isEmpty()) {
            error("Llena todos los campos.", campos[0]);
            return;
        }
        if (nivel.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Selecciona el nivel de cinta.",
                    "Dato incorrecto", JOptionPane.ERROR_MESSAGE);
            cmbCinta.requestFocus();
            return;
        }
        if (!telefono.matches("\\d{10}")) {
            error("El teléfono debe tener 10 dígitos.", campos[1]);
            return;
        }
        int edad;
        try {
            edad = Integer.parseInt(edadTxt);
        } catch (NumberFormatException ex) {
            error("La edad debe ser un número.", campos[2]);
            return;
        }
        if (edad < 1 || edad > 100) {
            error("Escribe una edad válida.", campos[2]);
            return;
        }
        if (!correo.matches("^[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+$")) {
            error("El correo no es válido.", campos[3]);
            return;
        }

        alumnos.add(new String[] {nombre, telefono, String.valueOf(edad), correo, nivel});
        guardarEnArchivo(nombre, telefono, edad, correo, nivel);

        JOptionPane.showMessageDialog(this,
                "Alumno registrado:\n" + nombre + " (cinta " + nivel.toLowerCase() + ")\nTotal registrados: " + alumnos.size(),
                "Registro exitoso", JOptionPane.INFORMATION_MESSAGE);
        limpiar();
    }

    private void guardarEnArchivo(String nombre, String telefono, int edad, String correo, String nivel) {
        String linea = String.join(",", nombre, telefono, String.valueOf(edad), correo, nivel)
                + System.lineSeparator();
        try {
            Files.write(Paths.get("alumnos.csv"), linea.getBytes(StandardCharsets.UTF_8),
                    StandardOpenOption.CREATE, StandardOpenOption.APPEND);
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "No se pudo guardar en el archivo.",
                    "Aviso", JOptionPane.WARNING_MESSAGE);
        }
    }

    private void limpiar() {
        for (JTextField c : campos) {
            c.setText("");
        }
        cmbCinta.setSelectedIndex(0);
        campos[0].requestFocus();
    }

    private void error(String mensaje, JTextField campo) {
        JOptionPane.showMessageDialog(this, mensaje, "Dato incorrecto", JOptionPane.ERROR_MESSAGE);
        campo.requestFocus();
    }

    private static class Avatar extends JComponent {
        Avatar() { setPreferredSize(new Dimension(56, 56)); }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(new Color(160, 160, 160));
            g2.fillOval(0, 0, 54, 54);
            g2.setColor(Color.WHITE);
            g2.fillOval(19, 10, 16, 16);          
            g2.fillArc(10, 30, 34, 34, 0, 180);   
            g2.setColor(Color.DARK_GRAY);
            g2.setStroke(new BasicStroke(3));
            g2.drawOval(1, 1, 52, 52);
            g2.dispose();
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new RegistroAlumno().setVisible(true));
    }
}
